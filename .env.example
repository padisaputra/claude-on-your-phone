# Settings for the agent. install.sh copies this to /opt/claude-phone/.env and fills in the
# required part for you. Change anything later with: sudo nano /opt/claude-phone/.env
# then: sudo systemctl restart claude-phone. Never commit .env.

# ---------------------------------------------------------------- Required
# Token from @BotFather in Telegram. Whoever has it controls the bot, so keep it private.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id (the installer finds it when you send /start). Only these people
# can talk to the bot. Meant for one person: everyone listed shares the same memory.
# Separate several ids with commas.
ALLOWED_USER_IDS=

# ---------------------------------------------------------------- Claude login
# Leave both empty if you logged in with `claude auth login` as the claude user (the installer does that).
# Or set ONE of these instead:
#   a token from `claude setup-token` (uses your Pro/Max plan), or
#   an API key from platform.claude.com (pay per use).
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Behaviour
# The agent's home folder: CLAUDE.md (who it is) and memory/ (its notes) live here.
WORKDIR=/home/claude/workspace
# acceptEdits = edits files freely, plus the tools listed below. See "Security" in the README.
# Background workers use the same mode and tools.
CLAUDE_PERMISSION_MODE=acceptEdits
# Tools Claude may use without asking. Nobody can tap "approve" from Telegram,
# so anything not listed here is simply refused.
CLAUDE_ALLOWED_TOOLS=Bash,Read,Edit,Write,Glob,Grep
# Stop a single chat reply after this many minutes. Long work belongs in a background worker.
CLAUDE_TIMEOUT_MINUTES=20
# Your timezone, used for every time below (schedules, quiet hours, the nightly job).
# Without it the server's clock is used, which is often UTC.
# TZ=Europe/London
# Where the bot keeps its own state (sessions, jobs, schedules, usage). Default: ~/.claude-phone
# CLAUDE_PHONE_STATE=/home/claude/.claude-phone
# Where the bot's code lives. The service sets this for you; only change it if you moved the code.


# ---------------------------------------------------------------- Context cleanup
# A conversation is restarted fresh (after the agent writes a handoff note) when any of these hit.
# After this many messages:
SESSION_MAX_TURNS=40
# Size of Claude's context window, in tokens:
CONTEXT_WINDOW=200000
# ...and restart once the context is this full (0.6 = 60 percent):
ROTATE_AT=0.6
# Start fresh after this many hours of silence:
IDLE_HOURS=6
# How many recent messages are carried over into the fresh conversation:
RECENT_KEEP=6

# ---------------------------------------------------------------- Workers and usage guard
# Longer tasks run as background workers that text you when done. At most this many at once:
MAX_WORKERS=3
# Rough budget of your plan, in weighted tokens. At 60 percent new workers wait in a queue,
# at 80 percent running workers pause, and they carry on when usage drops. /usage shows where you are.
# Per rolling 5 hours:
USAGE_LIMIT_5H=2000000
# Per rolling week:
USAGE_LIMIT_WEEK=20000000

# ---------------------------------------------------------------- Schedules and heartbeat
# Use /schedule in chat to add your own reminders and recurring tasks.
# Heartbeat: every so often the agent decides whether it has something worth texting you
# (a schedule coming up, a finished job, a short check-in after a long quiet stretch).
HEARTBEAT=on
HEARTBEAT_EVERY_MIN=30
# Only during these hours (24 hour clock, your TZ):
HEARTBEAT_HOURS=09:00-22:00
# Never more than this many unprompted texts a day:
HEARTBEAT_MAX_PER_DAY=3
# Time of the morning message:
MORNING_AT=08:30

# ---------------------------------------------------------------- Nightly learning
# Once a night the agent reviews the day, writes memory/journal.md and memory/lessons.md,
# and puts ideas for changes in memory/proposals.md for you to answer with ok or no.
NIGHTLY=on
NIGHTLY_AT=03:00
